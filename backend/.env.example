# DATABASE CONFIG
# For Neon.tech, use the connection string from the dashboard
DATABASE_URL=postgres://user:pass@ep-hostname.aws.neon.tech/neondb

# AUTH CONFIG
JWT_SECRET=your_super_secret_jwt_key_here

# STRIPE CONFIG (If using Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CLOUDINARY CONFIG (For Persistent Image Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# APP CONFIG
PORT=5001
CLIENT_URL=https://your-wearino-frontend.vercel.app
NODE_ENV=production

# CHATBOT CONFIG (Optional)
PYTHON_CHATBOT_URL=http://localhost:8000
